FROM tensorflow/tensorflow:2.15.0-gpu

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y build-essential libssl-dev \
    libbz2-dev libssl-dev libreadline-dev \
    libffi-dev libsqlite3-dev tk-dev libpng-dev libfreetype6-dev llvm-12 llvm-12-dev \
    gfortran gcc locales python3-tk \
    nano git wget curl graphviz -y
COPY requirements_training.txt requirements.txt
RUN python3 -m pip install -r requirements.txt --ignore-installed
#RUN python3.10 /usr/bin/exoml/iatson_planet.py